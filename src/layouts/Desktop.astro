---
// ﹒⭒﹒⭒﹒⭒﹒ Stylesheets ﹒⭒﹒⭒﹒⭒﹒ //
import '🧡/styles/main.css'

// ﹒⭒﹒⭒﹒⭒﹒ Components ﹒⭒﹒⭒﹒⭒﹒ //
import Head from '🧡/components/Head.astro'
import UICursor from '🧡/components/UI/Cursor.astro'
import UIMenu from '🧡/components/UI/Menu.astro'
import UITaskbar from '🧡/components/UI/Taskbar.astro'
---

<!doctype html>
<html lang="en">
	<head>
		<Head>
			<slot name="head" />
		</Head>
	</head>
	<body>
		<UICursor />

		<main class="desktop">
			<slot name="apps" />
			<slot name="nav" />

			<div class="desktop__cards">
				{Astro.slots.has('apps') || Astro.slots.has('nav') ? (
					<div
						style="display: flex; justify-content: end; margin-bottom: 0.55rem;"
					>
						<label
							class="toggle-maximize link"
							style="font-size: var(--text-xs);"
						>
							<input type="checkbox" id="checkbox_card" />

							<div class="u-group--flex">
								<span id="checkbox_card-value">Maximize Cards</span>
								<svg
									style="width: 1.2em;"
									xmlns="http://www.w3.org/2000/svg"
									fill="none"
									stroke="currentColor"
									viewBox="-.5 0 25 25"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="1.5"
										d="M11.5 4.25h-5a4 4 0 0 0-4 4v10a4 4 0 0 0 4 4h10a4 4 0 0 0 4-4v-5m-9.07.13 9.49-9.49m-5.13-.64h3.7a2 2 0 0 1 2 2v3.71"
									/>
								</svg>
							</div>
						</label>
					</div>
				) : null}
				<slot />
			</div>
		</main>
		<UITaskbar transition:persist />
		<!-- <img
			class="adachiRei"
			style="pointer-events: none; z-index: 1"
			src="/adachi-victory.gif"
			alt="An adorable plushie with an appearance of a orange haired girl dancing happily"
		> -->
		<UIMenu transition:persist />
	</body>
</html>

<script>
	document.addEventListener('astro:page-load', () => {
		const observer = new IntersectionObserver(
			entries => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						entry.target.classList.add('cards-reveal')
						observer.unobserve(entry.target)
					}
				})
			},
			{ threshold: 0.3 },
		)

		document
			.querySelectorAll('.card, .box')
			.forEach(el => observer.observe(el))
	})
</script>

<script>
	document.addEventListener('astro:page-load', () => {
		if (!document.querySelector('.giscus')) return

		const syncGiscusTheme = () => {
			const theme =
				localStorage.getItem('theme') ??
				document.documentElement.getAttribute('data-theme') ??
				'light'
			const frame = document.querySelector<HTMLIFrameElement>(
				'iframe.giscus-frame',
			)
			if (!frame?.contentWindow) return

			frame.contentWindow.postMessage(
				{
					giscus: {
						setConfig: {
							theme:
								theme === 'dark'
									? 'catppuccin_mocha'
									: 'catppuccin_latte',
						},
					},
				},
				'https://giscus.app',
			)
		}

		// Watch for theme toggles
		const themeObserver = new MutationObserver(syncGiscusTheme)
		themeObserver.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-theme'],
		})

		// Wait for iframe then sync
		const frame = document.querySelector<HTMLIFrameElement>(
			'iframe.giscus-frame',
		)
		if (frame) {
			frame.addEventListener('load', syncGiscusTheme)
			syncGiscusTheme()
		} else {
			const iframeObserver = new MutationObserver(() => {
				const frame = document.querySelector<HTMLIFrameElement>(
					'iframe.giscus-frame',
				)
				if (frame) {
					iframeObserver.disconnect()
					frame.addEventListener('load', syncGiscusTheme)
					syncGiscusTheme()
				}
			})
			iframeObserver.observe(document.body, {
				childList: true,
				subtree: true,
			})
		}
	})
</script>

<script>
	document.addEventListener('astro:page-load', () => {
		const checkbox_card = document.querySelector(
			'input[type="checkbox"]#checkbox_card',
		) as HTMLInputElement
		const checkbox_card_val = document.querySelector(
			'span#checkbox_card-value',
		) as HTMLElement

		checkbox_card.addEventListener('change', (e: Event) => {
			const target = e?.target as HTMLInputElement

			if (target.checked) {
				checkbox_card_val.textContent = 'Minimize Cards'
			} else {
				checkbox_card_val.textContent = 'Maximize Cards'
			}
		})
	})
</script>
