---
import { SITE } from '🧡/consts'
import { SEO, type SEOProps } from 'astro-seo'

const { props }: { props: SEOProps } = Astro

const defaultSEO: SEOProps = {
	title: props.title,
	titleTemplate: SITE.title + ' | %s',
	description: props.description || SITE.description,
	canonical: SITE.href,

	openGraph: {
		basic: {
			title: SITE.title,
			image: '',
			type: 'website',
			url: Astro.url,
		},
		optional: {
			locale: SITE.locale,
			siteName: SITE.title,
		},
	},
	extend: {
		link: [
			{ rel: 'sitemap', href: '/sitemap-index.xml' },
			{ rel: 'canonical', href: SITE.href },
		],
	},
}

const combinedProps = { ...props, ...defaultSEO }
---

<SEO {...combinedProps} />

