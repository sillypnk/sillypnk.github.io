---
import { SITE } from '🧡/consts'
import { SEO, type SEOProps } from 'astro-seo'

const { props }: { props: SEOProps } = Astro

const defaultSEO: SEOProps = {
	title: props.title || SITE.title,
	titleTemplate: 'PumoChii | %s',
	description: props.description || SITE.description,
	canonical: SITE.href,

	openGraph: {
		basic: {
			title: SITE.title,
			image: '/static/twitter-card.png',
			type: 'website',
			url: Astro.url,
		},
	},

	// TODO: Twitter image and other stuff
}

const combinedProps = { ...props, ...defaultSEO }
---

<SEO {...combinedProps} />

