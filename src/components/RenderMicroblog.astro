---
// ﹒⭒﹒⭒﹒⭒﹒ Assets ﹒⭒﹒⭒﹒⭒﹒ //
import Avatar from '🧡/components/UI/Avatar.astro'

// ﹒⭒﹒⭒﹒⭒﹒ Layouts ﹒⭒﹒⭒﹒⭒﹒ //
import { getRelativeTimeString } from '🧡/lib/utils.ts'
import type { CollectionEntry } from 'astro:content'

interface Props {
	entry: CollectionEntry<'microblogs'>
}

const { entry } = Astro.props
const { data, id } = entry
---

<div style="position: relative;">
	<slot name="pinned" />

	<a
		href={'/microblog/' + id}
		style="position: absolute; inset: 0; z-index: 0;"
		aria-label="View microblog post"
	></a>
	<!-- ----------------- -->
	<div
		style="display: flex; align-items: center; vertical-align: middle; gap: 0.7rem"
	>
		<Avatar
			email="kumukuro@gmail.com"
			alt="Adachi Rei looking at the camera"
			imgStyles="outline: 1px solid var(--clr-base-content); outline-offset: 2px;"
			style="width: 3.55em; isolation: isolate;"
		/>
		<div style="display: block">
			<span
				style="font-size: var(--text-lg); color: var(--clr-base-content); line-height: 2px;"
				>PumoChii</span
			>
			<span
				style="display: block; font-size: var(--text-base); color: var(--clr-non-avail);"
				>@the_notsillypnk</span
			>
		</div>

		<div
			style="margin-left: auto; color: var(--clr-base-content); margin-top: auto;"
		>
			<svg
				style="width: 23px;"
				viewBox="0 0 24 24"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
			>
				<g id="SVGRepo_bgCarrier" stroke-width="0"></g>
				<g
					id="SVGRepo_tracurrentColorerCarrier"
					stroke-linecurrentcap="round"
					stroke-linejoin="round"
				></g>
				<g id="SVGRepo_icurrentColoronCarrier">
					<path
						d="M18 12H18.01M12 12H12.01M6 12H6.01M13 12C13 12.5523 12.5523 13 12 13C11.4477 13 11 12.5523 11 12C11 11.4477 11.4477 11 12 11C12.5523 11 13 11.4477 13 12ZM19 12C19 12.5523 18.5523 13 18 13C17.4477 13 17 12.5523 17 12C17 11.4477 17.4477 11 18 11C18.5523 11 19 11.4477 19 12ZM7 12C7 12.5523 6.55228 13 6 13C5.44772 13 5 12.5523 5 12C5 11.4477 5.44772 11 6 11C6.55228 11 7 11.4477 7 12Z"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecurrentcap="round"
						stroke-linejoin="round"
					></path>
				</g>
			</svg>
		</div>
	</div>

	<div
		style="
                      display: block;
                      margin-top: 0.8rem;
                      margin-inline: 5px;
                      color: light-dark(var(--clr-secondary), var(--clr-base));
                    "
	>
		<article class="prose">
			<slot />
		</article>

		<div
			style="display: block; margin-bottom: 5px; margin-top: 1.5rem; font-size: var(--text-xs); color: grey;"
		>
			<span>{getRelativeTimeString(data.date)}</span>
			-
			<span
				>{data.date.toLocaleString(navigator.language, { dateStyle: "short" })}</span
			>

			{data.updatedDate && (
                <span>
                    (Edited
         			<span>{getRelativeTimeString(data.updatedDate)}</span>
                    -
                    <span>{data.updatedDate.toLocaleString(navigator.language, { dateStyle: "short" })}</span>
                    )
                </span>
                )}
		</div>
		<div>
			{data.tags
							? data.tags.map((tag) => <span class="link" style="display: inline-block; font-size: var(--text-xs); margin-inline: 0.3rem;"> #{tag} </span>)
							: <p></p>}
		</div>

		<div
			style="
                    --_divider-color: light-dark(oklch(0.7448 0 0), oklch(0.3264 0 0));
                    --_divider-m: -20px 0;
                  "
			class="divider"
		></div>
	</div>
</div>
