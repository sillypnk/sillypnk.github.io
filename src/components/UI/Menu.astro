							/>
						</svg>
					</button>
				</form>
			</div>
			<div class="modal__info">
				<Avatar
					email="kumukuro@gmail.com"
					alt="Adachi Rei looking at the camera"
					imgStyles="outline: 1px solid var(--clr-base-content); outline-offset: 2px;"
					style="grid-area: avatar; width: min(8rem, 30vw);"
					size={70}
				/>
				<div
					class="u-group--flex items--x-centered"
					style="flex-direction: column; gap: 1px; margin-bottom: 0.85em;"
				>
					<h4
						class="name"
						style="grid-area: name;"
						style="line-height: 0; margin: 0;"
					>
						PumoChii
