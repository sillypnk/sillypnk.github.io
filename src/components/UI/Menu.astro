				</div>
				<div
					style="display: grid; grid-template-columns: repeat(auto-fill, minmax(2.75rem, 1fr)); gap: 0.25em; text-align: left;"
				>
					<Link
						class="btn"
						style="margin: 0;"
						href="https://github.com/sillypnk/"
