						noUnderline
					>
						<Icon style="width: 2.5em;" name="socials/github" />
					</Link>

					<Link
						class="btn"
						style="margin: 0;"
						href="https://www.tiktok.com/@reishichii?_r=1&_t=ZS-96yhJ0EgOSO"
						external
						noUnderline
					>
						<Icon style="width: 2.5em;" name="socials/tiktok" />
					</Link>

					<Link
						class="btn"
						style="margin: 0;"
						href="https://www.last.fm/user/Pumoreiichi"
						external
						noUnderline
					>
						<Icon style="width: 2.5em;" name="socials/lastfm" />
					</Link>
					<Link
						class="btn"
						style="margin: 0;"
						href="https://bsky.app/profile/pumoreiichi.bsky.social"
						external
						noUnderline
