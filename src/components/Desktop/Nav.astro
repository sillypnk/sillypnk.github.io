---
import Link from '🧡/components/Link.astro'
// import Bars from '🧡/components/UI/Bars.astro'
import Card from '🧡/components/UI/Card.astro'

import { Image } from 'astro:assets'
import { Icon } from 'astro-iconset/components'

//*****   Props  ******//
interface Props {
	icon: ImageMetadata
	to: string
}

const { icon, to } = Astro.props
---

<aside class="desktop__nav">
	<Card
		contentStyles="padding-block-end: 1em; padding-block-start: 0; padding-inline: 0; block-size: max-content;"
		alternate
	>
		<Link
			class="btn u-group--flex"
			style="width: max-content; position: absolute;"
			href="/"
			aria-label="Go back"
			noUnderline
		>
			<Icon name="arrow_left" />
		</Link>

		<!-- Nav Icon -->
		<div
			class="u-group--grid"
			style="place-items: center; margin-bottom: 2em;"
		>
			<Image
				style="pointer-events: none; margin-block-start: 2em;"
				src={icon}
				alt="Nav Icon"
				priority
			/>

			<Link href={"/" + to.toLowerCase()}
				>{to.charAt(0).toUpperCase() + to.slice(1)}</Link
			>
		</div>

		<slot name="links" />
	</Card>

	<!-- TODO: Mini music component -->
	<!-- <pumo-minimusic>
				</pumo-minimusic> -->

	<slot />

	<!-- TODO: Some stuff -->
