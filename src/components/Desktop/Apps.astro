---
import DesktopIcon from './Icon.astro'
import { APPS } from '🧡/consts'
---

<aside class="desktop__apps">
	{APPS.map(({ icon, label }) => (
            <DesktopIcon opts={{ src: icon, alt: `${label} Icon`, to: label === "Home" ? "" : label.toLowerCase() }}>
            	{label}
            </DesktopIcon>
			)
		)}

	<article
		class="box"
		style="
						grid-column: 1 / -1;
						width: 100%;
						height: unset;
						padding: 0;
						margin: 0;
						align-self: start;
						background: linear-gradient(
      180deg,
      light-dark(
          var(--clr-base),
          oklch(from var(--clr-base-content) l c h / 21%)
        )
        5%,
      light-dark(
          var(--clr-base),
          oklch(from var(--clr-secondary) calc(l - 0.1) c h / 80%)
        )
        100%
    );
					"
	>
		<div style="display: flex;">
			<div
				class="scroll-container"
				style="
								text-align: left;
								margin-left: 0.4rem;
							"
			>
				<input
					id="search"
					type="text"
					style="
									height: 100%;
									font-family: var(--font-tickerbit);
									background: inherit;
									color: light-dark(
										var(--clr-secondary),
										var(--clr-base)
									);
									width: 100%;
								"
					placeholder="Search..."
				>
			</div>
			<div
				class="music-btn"
				style="
								border-right: none;
								border-left: 2px solid var(--clr-base-content);
								color: light-dark(
									var(--clr-secondary),
									var(--clr-base)
								);
							"
			>
				<svg
					style="width: 1.2em"
					fill="currentColor"
					viewBox="0 0 400 400"
					id="Search"
					version="1.1"
					xml:space="preserve"
					xmlns="http://www.w3.org/2000/svg"
					xmlns:xlink="http://www.w3.org/1999/xlink"
					stroke="currentColor"
				>
					<g stroke-width="0"></g>
					<g stroke-linecap="round" stroke-linejoin="round"></g>
					<g>
						<g id="XMLID_14_">
							<polygon
