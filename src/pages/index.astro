<style>
	.banner {
		/*debugging purposes*/
		/*outline: 2px solid red;*/
		position: relative;
		display: inline-flex;
		vertical-align: middle;

		& > div {
			display: block;
			aspect-ratio: 3.5 / 1;
			overflow: hidden;
		}

		img {
			height: 100%;
			width: 100%;
			object-fit: cover;
		}
	}

	.bento {
		display: grid;
		grid-template-columns: 10rem 1fr 1fr;
		grid-template-rows: 17rem 4rem 17.5rem 5rem;
		grid-template-areas:
			"a a b b"
			"a a c c"
			"d e f f"
			"d e g g";
		gap: 1.5rem;
		min-width: 0;

		@media (max-width: 1024px) {
			grid-template-columns: 1fr 6.6rem;
			grid-template-rows: none;
			grid-template-areas:
				"a g"
				"b b"
				"c c"
				"d d"
				"f f"
				"e e";
		}

		@media (max-width: 640px) or (max-width: 950px) {
			grid-template-columns: 1fr;
			/*grid-template-rows: repeat(2, 1fr) 4rem 1fr 10rem 1fr;*/
			/*grid-template-rows: repeat(6, auto);*/
			grid-template-rows: repeat(2, 18rem) auto auto 5rem 18rem 5rem;
			grid-template-areas:
				"a"
				"b"
				"c"
				"e"
				"g"
				"f"
				"d";
		}
	}

	.bento :global(:is(.card, .box)) {
		height: 100%;
		min-width: 100%;
		margin: 0;
	}
	.bento :global(.card:first-child) {
		grid-area: a;
	}
	.bento :global(.card:nth-child(2)) {
		grid-area: b;
	}
	.bento :global(.box:nth-child(3)) {
		grid-area: c;
	}
	.bento :global(.box:nth-child(4)) {
		grid-area: d;
	}
	.bento :global(.card:nth-child(5)) {
		grid-area: e;
	}
	.bento :global(.card:nth-child(6)) {
		grid-area: f;
	}
	.bento :global(.box:nth-child(7)) {
		grid-area: g;
	}

	.adachi-line {
		padding: 0;
		justify-content: center;
		display: block;
		background: var(--clr-base-content);

		container: adachiLine / inline-size;

		svg:first-child {
			display: block;
		}
		svg:last-child {
			display: none;
		}

		@container adachiLine (max-width: 10rem) {
			svg:first-child {
				display: none;
			}
			svg:last-child {
				display: block;
			}
		}
	}

