---
// ﹒⭒﹒⭒﹒⭒﹒ Assets ﹒⭒﹒⭒﹒⭒﹒ //
import MicroblogIcon from '🧡/assets/icons/desktop/notepad.png'
//
// ﹒⭒﹒⭒﹒⭒﹒ Components ﹒⭒﹒⭒﹒⭒﹒ //
import DesktopNav from '🧡/components/Desktop/Nav.astro'
import PageHead from '🧡/components/PageHead.astro'
import RenderMicroblog from '🧡/components/RenderMicroblog.astro'
import Card from '🧡/components/UI/Card.astro'
import Breadcrumbs from '🧡/components/UI/Breadcrumbs.astro'
import Avatar from '🧡/components/UI/Avatar.astro'

// ﹒⭒﹒⭒﹒⭒﹒ Layouts ﹒⭒﹒⭒﹒⭒﹒ //
import Desktop from '🧡/layouts/Desktop.astro'

import { Icon } from 'astro-iconset/components'
import { getAllMicroblogs, getPinnedMicroblog } from '🧡/lib/data-utils.ts'

const microblogs = await getAllMicroblogs()
const pinnedMicroblog = await getPinnedMicroblog()

const posts = microblogs.filter(post => !post.data.pinned)
---

<Desktop>
	<PageHead slot="head" title="Microblogs" />
	<DesktopNav icon={MicroblogIcon} to="microblog" slot="nav">
		<Breadcrumbs items={[{ label: "Microblog", icon: "microblog/breadcrumbs/pixelated-note" }]} />
		<!-- TODO: Filtering options for microblogs -->
