<style>
	.banner {
		/*debugging purposes*/
		/*outline: 2px solid red;*/
		position: relative;
		display: inline-flex;
		vertical-align: middle;

		& > div {
			display: block;
			aspect-ratio: 3.5 / 1;
			overflow: hidden;
		}

		img {
			height: 100%;
			width: 100%;
			object-fit: cover;
			/*object-position: 45%;*/
		}
	}

	.bento {
		display: grid;
		/*grid-template-columns: 1fr 1fr;
            grid-template-rows: 18rem 8rem 7rem;*/
		grid-template-columns: 19rem 9rem 1fr;
		grid-template-rows: 17rem 8rem auto;
		grid-template-areas:
			"a a b b"
			"a a c c"
			"d e f f";
		gap: 1.5rem;
	}

	.bento :global(.card) {
		height: 100%;
		margin: 0;
	}
	.bento :global(.card:first-child) {
		grid-area: a;
	}
	.bento :global(.card:nth-child(2)) {
		grid-area: b;
	}
	.bento :global(.card:nth-child(3)) {
		grid-area: c;
	}
	.bento :global(.card:nth-child(4)) {
		grid-area: d;
	}
	.bento :global(.card:last-child) {
		grid-area: f;
	}
	.bento :global(.box:nth-child(5)) {
		grid-area: e;
	}

	.squiggly-line {
		fill: none;
		stroke: #fc8c03;
		stroke-width: 4;
		stroke-miterlimit: 10;
		stroke-dasharray: 100;
		animation: squiggle 1.6s 5s linear infinite;
	}
	@keyframes squiggle {
		to {
			stroke-dashoffset: -200;
		}
	}

	:global(.pill.pill-profile) {
		--pill-color: light-dark(var(--clr-secondary), var(--clr-base));
		--pill-color-content: light-dark(var(--clr-base), var(--clr-secondary));
		--pill-py: 0;
		border-radius: 0;
		position: relative;
		place-items: center;
		font-size: 0.85em;
		margin: 0;
		letter-spacing: 2px;
		width: calc(100% - 12rem);
		clip-path: polygon(
			calc(0% + 2%) 0%,
			100% 0%,
			calc(100% - 2%) 100%,
			0% 100%
		);
	}

	.status {
		display: grid;
		grid-template-rows: repeat(4, auto);
		grid-template-columns: repeat(2, auto);
		gap: 8px;
		inline-size: 100%;

		padding-block: 0.8rem;
		padding-inline: 0.8em;
		background-color: inherit;

		h5 {
			z-index: 1;
			position: relative;
			margin-left: 0.5em;
		}
		h5::before {
			content: "#";
			font-family: var(--font-yuruka-std);
			position: absolute;
			left: -15px;
			top: 20px;
			z-index: -1;
			color: white;
			opacity: 10%;
			font-size: 10rem;
		}
	}
	[data-theme="dark"] .status {
		background-color: oklch(
			from var(--clr-primary) calc(l - 0.8) c h /
			50%
		);
	}

